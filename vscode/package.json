{
  "name": "cel-lens-vscode",
  "displayName": "cel-lens for VS Code",
  "description": "CEL errors, hover and completion inside Kubernetes YAML.",
  "version": "0.35.0",
  "publisher": "cel-lens",
  "repository": {
    "type": "git",
    "url": "https://github.com/JairJosafath/cel-lens",
    "directory": "vscode"
  },
  "private": true,
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "keywords": [
    "cel",
    "kubernetes",
    "crd",
    "x-kubernetes-validations",
    "validatingadmissionpolicy"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:cel-lens-example"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cel-lens.restartServer",
        "title": "Restart Engine",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.pickKubernetesVersion",
        "title": "Pick Kubernetes Version",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.showActions",
        "title": "Show Actions",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.showLogs",
        "title": "Show Logs",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.chooseColorStyle",
        "title": "Choose Color Style",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.toggleInlineInfo",
        "title": "Toggle Inline Info",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.showRule",
        "title": "Show Rule",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.listValues",
        "title": "Show More of the Rule",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.giveValueType",
        "title": "Give a Value a Type…",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.giveType",
        "title": "Give the Value a Type",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.editType",
        "title": "Edit the Value's Type",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.removeType",
        "title": "Remove the Value's Type",
        "category": "cel-lens"
      },
      {
        "command": "cel-lens.useExample",
        "title": "Use This Example as the Type",
        "category": "cel-lens",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "cel-lens",
      "properties": {
        "cel-lens.colorStyle": {
          "type": "string",
          "enum": [
            "cel",
            "classic",
            "off"
          ],
          "enumDescriptions": [
            "Plum and lavender, the hues of the cel-lens logo.",
            "Warm browns and ambers, close to a plain YAML string.",
            "No cel-lens colors; the theme alone colors the YAML."
          ],
          "default": "cel",
          "scope": "resource",
          "order": 0,
          "markdownDescription": "The color style for the parts of a CEL expression in Kubernetes YAML. Pick it from the status bar menu or with **cel-lens: Choose Color Style**."
        },
        "cel-lens.inlineInfo": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 1,
          "markdownDescription": "Shows a line above each CEL rule: what `self` is, whether the rule compiles, and the values it reads as `dyn`. Turn it off and on with **cel-lens: Toggle Inline Info** or from the status bar menu."
        },
        "cel-lens.kubernetesVersion": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 2,
          "markdownDescription": "Advanced: the Kubernetes version the results match, such as `1.36`. Leave empty to use the engine's default."
        },
        "cel-lens.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "order": 3,
          "markdownDescription": "Traces the messages between VS Code and the engine in the cel-lens output channel.",
          "enumDescriptions": [
            "No tracing.",
            "Trace the messages without their contents.",
            "Trace the messages with their contents."
          ]
        },
        "cel-lens.experimental": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "kyverno",
              "crd-typed-policies",
              "fitting-completion"
            ],
            "enumDescriptions": [
              "Colors, checks, hovers and completes Kyverno ValidatingPolicy documents; experimental because compiled with Kyverno's compiler but never run against Kyverno's engine; only ValidatingPolicy is read.",
              "Types the params, and the object and oldObject of a policy that matches a custom resource, from a CustomResourceDefinition found in the workspace, and hover says the feature is off when it is; experimental because the workspace scan runs only while the feature is on, at initialize or when the setting turns it on. It runs in the background and open documents are checked again when it ends. It reads at most 20000 YAML files and skips files over 1 MiB, so a CRD past either limit leaves its type dyn; the engine warns once at the file cap; a single skipped file is logged on its own line, and many are reported in one summary log line with their count, the limit and the first three names.",
              "After a dot completion offers only what the receiver has, before a dot only the names of the document, and hover says why a value is dyn; experimental because built after v0.17.1 of the engine and not yet proven on real use."
            ]
          },
          "uniqueItems": true,
          "default": [],
          "scope": "window",
          "order": 5,
          "markdownDescription": "Advanced: the experimental features to turn on. An experimental feature is off until you list it here; a name the engine does not know is ignored and reported once in a notification."
        },
        "cel-lens.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 4,
          "markdownDescription": "Advanced: path to a `cel-lens-core` binary to use instead of the engine bundled with the extension. Leave empty."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cel-lens.restartServer",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.pickKubernetesVersion",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.showActions",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.showLogs",
          "when": "true"
        },
        {
          "command": "cel-lens.chooseColorStyle",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.toggleInlineInfo",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.showRule",
          "when": "false"
        },
        {
          "command": "cel-lens.listValues",
          "when": "false"
        },
        {
          "command": "cel-lens.giveValueType",
          "when": "editorLangId == yaml"
        },
        {
          "command": "cel-lens.giveType",
          "when": "false"
        },
        {
          "command": "cel-lens.editType",
          "when": "false"
        },
        {
          "command": "cel-lens.removeType",
          "when": "false"
        },
        {
          "command": "cel-lens.useExample",
          "when": "resourceScheme == cel-lens-example"
        }
      ],
      "editor/title": [
        {
          "command": "cel-lens.useExample",
          "when": "resourceScheme == cel-lens-example",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "dist": "node src/dist.ts",
    "bench": "esbuild src/*.bench.ts --bundle --platform=node --format=esm --alias:vscode=./test/vscode.ts --outdir=out/bench --out-extension:.js=.mjs --log-level=warning && for f in out/bench/*.mjs; do node --expose-gc $f || exit 1; done",
    "profile": "esbuild src/cel_tokens.profile.ts --bundle --platform=node --format=esm --outdir=out/profile --out-extension:.js=.mjs --log-level=warning && node --expose-gc --cpu-prof --cpu-prof-dir=out/profile out/profile/cel_tokens.profile.mjs",
    "engine": "node src/dist.ts install",
    "links": "node src/check_links.ts",
    "pictures": "node test/pictures/take.ts",
    "e2e": "npm run engine && vitest run --config vitest.e2e.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "gifenc": "1.0.3",
    "jpeg-js": "0.4.4",
    "markdown-it": "15.0.3",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "tinybench": "6.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vscode-languageserver-protocol": "3.18.5",
    "yaml": "2.9.1"
  },
  "pictures": {
    "openvscodeServer": "1.109.5"
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": false
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "homepage": "https://github.com/JairJosafath/cel-lens/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/JairJosafath/cel-lens/issues"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@vscode/vsce": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    }
  }
}
